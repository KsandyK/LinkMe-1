"{\r\n  \"name\": \"workspace\",\r\n  \"version\": \"0.0.0\",\r\n  \"license\": \"MIT\",\r\n    \"scripts\": {\n    \"dev\": \"concurrently \\\"pnpm --filter api-server dev\\\" \\\"echo  Frontend workspace coming in next step\\\"\",\n    \"dev:api\": \"pnpm --filter api-server dev\",\n    \"dev:frontend\": \"echo \\\"Frontend not yet migrated - coming in Step 4\\\"\",\n    \"build\": \"pnpm --filter api-server build\",\n    \"start\": \"pnpm --filter api-server start\",\n    \"docker:up\": \"docker compose up --build\",\n    \"docker:down\": \"docker compose down\",\n    \"clean\": \"pnpm store prune \u0026\u0026 pnpm install --ignore-scripts\"\n  },,}catch(e){console.error(e);process.exit(1);}\\\"\",\r\n    \"build\": \"pnpm run typecheck \u0026\u0026 pnpm -r --if-present run build\",\r\n    \"dev:frontend\": \"set PORT=3000\u0026\u0026 set BASE_PATH=/\u0026\u0026 pnpm --filter @workspace/vibelink run dev\",\r\n    \"dev:api\": \"set PORT=4000\u0026\u0026 pnpm --filter @workspace/api-server run build \u0026\u0026 pnpm --filter @workspace/api-server run start\",\r\n    \"dev:local\": \"powershell.exe -NoLogo -ExecutionPolicy Bypass -Command \\\"Start-Process pnpm -ArgumentList \u0027run\u0027,\u0027dev:api\u0027 -NoNewWindow; Start-Process pnpm -ArgumentList \u0027run\u0027,\u0027dev:frontend\u0027 -NoNewWindow; Wait-Process -Name pnpm\\\"\",\r\n    \"typecheck:libs\": \"tsc --build\",\r\n    \"typecheck\": \"pnpm run typecheck:libs \u0026\u0026 pnpm -r --filter \\\"./artifacts/**\\\" --filter \\\"./scripts\\\" --if-present run typecheck\"\r\n  },\r\n  \"private\": true,\r\n  \"devDependencies\": {\r\n    \"prettier\": \"^3.8.1\",\r\n    \"typescript\": \"~5.9.2\"\r\n  },\r\n  \"dependencies\": {\r\n    \"@esbuild/win32-x64\": \"^0.27.3\",\r\n    \"@rollup/rollup-win32-x64-msvc\": \"^4.60.4\",\r\n    \"@tailwindcss/oxide-win32-x64-msvc\": \"4.2.1\",\r\n    \"lightningcss-win32-x64-msvc\": \"1.31.1\",\r\n    \"rollup\": \"^4.60.4\"\r\n  }\r\n}\r\n\r\n"
