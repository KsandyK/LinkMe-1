# ─────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─────────────────────────────────────────────
# Database — PostgreSQL
# Use DIRECT_URL for Prisma migrations (bypasses PgBouncer)
# Use DATABASE_URL for the app (goes through pooler)
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://CRAVR:password@localhost:5432/CRAVR?pgbouncer=true&connection_limit=10"
DIRECT_URL="postgresql://CRAVR:password@localhost:5432/CRAVR"

# ─────────────────────────────────────────────
# Auth
# Generate with: openssl rand -hex 64
# ─────────────────────────────────────────────
JWT_SECRET="replace-with-64-byte-random-hex"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="30d"
BCRYPT_ROUNDS=12

# ─────────────────────────────────────────────
# WebSocket / WebRTC
# ─────────────────────────────────────────────
WS_PORT=3001

# TURN server credentials (use coturn or a managed service like Twilio)
TURN_URL="turn:your-turn-server.com:3478"
TURN_USERNAME="CRAVR"
TURN_CREDENTIAL="replace-with-turn-password"

# ─────────────────────────────────────────────
# Payments — CCBill
# ─────────────────────────────────────────────
CCBILL_CLIENT_ACCNUM=
CCBILL_SUBACCOUNT=
CCBILL_FORM_NAME=
CCBILL_SALT=
CCBILL_WEBHOOK_SECRET=

# ─────────────────────────────────────────────
# Age Verification
# Store document references (NOT files) — raw docs go to S3/KMS
# ─────────────────────────────────────────────
AGE_VERIFY_S3_BUCKET=
AGE_VERIFY_KMS_KEY_ID=
AGE_VERIFY_ENCRYPTION_KEY="replace-with-32-byte-aes-key"

# ─────────────────────────────────────────────
# Bunny.net CDN + Storage
# Storage zone password: dash.bunny.net → Storage → cravr-media → FTP & API Access
# CDN token key: dash.bunny.net → CDN → cravr-cdn → Security → Token authentication
# ─────────────────────────────────────────────
BUNNY_STORAGE_ZONE=cravr-media
BUNNY_STORAGE_PASSWORD=          # Password from Storage → cravr-media → Access tab
BUNNY_STORAGE_REGION=ny          # ny | la | sg | sy | uk | de | br | jh | se
# Endpoint: https://{region}.storage.bunnycdn.com/{zone}/path — e.g. https://ny.storage.bunnycdn.com/cravr-media/
BUNNY_CDN_HOSTNAME=cdn.cravr.fun
BUNNY_CDN_TOKEN_KEY=             # paste the token authentication key from Bunny dashboard

# ─────────────────────────────────────────────
# Bunny Stream (VOD — creator uploaded videos)
# Library: cravr-videos | dash.bunny.net → Stream → cravr-videos → API
# ─────────────────────────────────────────────
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=

# ─────────────────────────────────────────────
# Email — Resend (transactional)
# Get API key: resend.com → API Keys
# Sending domain: send.cravr.fun (DNS already configured)
# ─────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@cravr.fun

# ─────────────────────────────────────────────
# Owner / Admin Account (run: pnpm db:seed-owner)
# Never commit real values — keep only in .env
# ─────────────────────────────────────────────
OWNER_USERNAME=
OWNER_PASSWORD=
OWNER_EMAIL=

# ─────────────────────────────────────────────
# AI Companions — Anthropic Claude
# Get key: console.anthropic.com → API Keys
# Powers auto-replies from AI persona creators
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────
# Rate limiting overrides
# ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
