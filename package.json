{
    "name": "vibelink-workspace",
    "version": "1.0.0",
    "private": true,
    "license": "MIT",
    "scripts": {
        "dev": "concurrently \"pnpm --filter api-server dev\" \"pnpm --filter frontend dev\"",
        "dev:api": "pnpm --filter api-server dev",
        "dev:frontend": "pnpm --filter vibelink dev",
        "build": "pnpm --filter api-server build && pnpm --filter frontend build",
        "start": "pnpm --filter api-server start",
        "docker:up": "docker compose up --build",
        "docker:down": "docker compose down",
        "clean": "pnpm store prune && pnpm install --ignore-scripts"
    },
    "devDependencies": {
        "@rollup/rollup-win32-x64-msvc": "^4.60.4",
        "concurrently": "^9.2.1",
        "cross-env": "^10.1.0",
        "lightningcss-win32-x64-msvc": "^1.32.0"
    },
    "pnpm": {
        "patchedDependencies": {}
    }
}

