################################################################################
# CRAVR — Production Environment Variables
#
# Copy this file: cp .env.production.example .env
# Fill in every value before running docker compose.
# NEVER commit the filled-in .env file to git.
################################################################################

# ── Domain ────────────────────────────────────────────────────────────────────
# Your domain name (no https://, no trailing slash)
# Example: cravr.fun
DOMAIN=yourdomain.com

# Full public API URL used by the frontend at Vite build time
# Must include https:// and no trailing slash
VITE_API_URL=https://yourdomain.com

# Origins allowed to call the API (comma-separated, no spaces)
# Add www. variant if needed
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Database ──────────────────────────────────────────────────────────────────
# These values are used by the postgres container AND the api container
POSTGRES_DB=CRAVR
POSTGRES_USER=CRAVR
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# Prisma connection strings (auto-built from above in docker-compose.prod.yml)
# If you use an external DB (e.g. Supabase, Neon), set these directly instead:
# DATABASE_URL=postgresql://user:pass@host:5432/CRAVR?sslmode=require
# DIRECT_URL=postgresql://user:pass@host:5432/CRAVR?sslmode=require

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_64_BYTE_HEX_SECRET

# ── CCBill Payment Processing ─────────────────────────────────────────────────
# Get these from your CCBill merchant account dashboard
CCBILL_CLIENT_ACCNUM=your_client_account_number
CCBILL_SUBACCOUNT=0000
CCBILL_FORM_NAME=cc_payment.html
CCBILL_SALT=your_ccbill_salt_key
CCBILL_WEBHOOK_SECRET=your_ccbill_webhook_secret

# CCBill Background Post URL (register this in your CCBill merchant panel):
# https://yourdomain.com/api/credits/webhook

# ── AWS S3 (file uploads, age verification docs) ──────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_BUCKET=CRAVR-uploads

AGE_VERIFY_S3_BUCKET=cravr-age-verify
AGE_VERIFY_KMS_KEY_ID=your_kms_key_id
AGE_VERIFY_ENCRYPTION_KEY=your_32_byte_hex_encryption_key

# ── SRS Live Streaming ────────────────────────────────────────────────────────
# Shared secret between SRS and the API for webhook validation.
# Set the same value in srs.conf http_hooks (param ?secret=...) if used.
# Generate with: openssl rand -hex 32
SRS_WEBHOOK_SECRET=CHANGE_ME_SRS_WEBHOOK_SECRET

# ── Bunny.net CDN ─────────────────────────────────────────────────────────────
# Pull Zone CDN hostname (no trailing slash).
# In Bunny dashboard: Storage > Pull Zone > CDN Hostname
# Format: https://<your-zone-name>.b-cdn.net
BUNNY_CDN_URL=https://your-zone-name.b-cdn.net

# Bunny Pull Zone origin must be set to: https://yourdomain.com/hls/
# (nginx proxies /hls/ → SRS HTTP port 8080 internally)

# ── Stripe (optional — enable card payments) ──────────────────────────────────
# Leave blank to disable Stripe; CCBill will be the only payment method.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLIC_KEY=
VITE_STRIPE_ENABLED=false
